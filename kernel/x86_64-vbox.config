# VirtualBox on x86 hosts (THIR_FLAVOR=vbox): the VM disk is SATA (AHCI) and the screen is VMSVGA.
# The USB-stick image does NOT use this file: it must never get SATA/NVMe drivers.
CONFIG_CMDLINE="console=ttyS0,115200 panic=1 video=Virtual-1:1920x1080"
CONFIG_ATA=y
CONFIG_SATA_HOST=y
CONFIG_SATA_AHCI=y
CONFIG_HYPERVISOR_GUEST=y
CONFIG_DRM_VMWGFX=y
