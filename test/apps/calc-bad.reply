Here is the app.
===APP===
name: calc
title: Calc
about: A calculator
net: none
===CODE===
-- A small calculator: type an expression, press = (or enter) for the answer.
local expr, result = "", nil

local function evaluate(s)
  local pos = 1
  local function peek() return s:sub(pos, pos) end
  local sum
  local function value()
    local c = peek()
    if c == "(" then
      pos = pos + 1
      local v = sum()
      if peek() ~= ")" then error("missing )") end
      pos = pos + 1
      return v
    elseif c == "-" then
      pos = pos + 1
      return -value()
    end
    local a, b = s:find("^%d+%.?%d*", pos)
    if not a then a, b = s:find("^%.%d+", pos) end
    if not a then error("number expected") end
    pos = b + 1
    return tonumber(s:sub(a, b))
  end
  local function product()
    local v = value()
    while peek() == "*" or peek() == "/" do
      local op = peek()
      pos = pos + 1
      local r = value()
      if op == "*" then v = v * r else
        if r == 0 then error("division by zero") end
        v = v / r
      end
    end
    return v
  end
  function sum()
    local v = product()
    while peek() == "+" or peek() == "-" do
      local op = peek()
      pos = pos + 1
      local r = product()
      if op == "+" then v = v + r else v = v - r end
    end
    return v
  end
  local v = sum()
  if pos <= #s then error("unexpected " .. peek()) end
  return v
end

function draw(w, h)
  ui.title("Calc", "type an expression")
  ui.text(3, 3, "> " .. expr .. "_", "accent")
  if result then
    ui.text(3, 5, "= " .. result, result:find("^[%d%.%-]") and "good" or "bad")
  else
    ui.text(3, 5, "Press = for the answer.", "dim")
  end
  ui.footer("0-9 + - * / ( ) . · = answer · c clear · backspace · q quit")
end

function key(k)
  if k:find("^[%d%+%-%*/%(%)%.]$") then
    if #expr < 60 then expr = expr .. k end
    result = nil
  elseif k == "backspace" then
    expr = expr:sub(1, -2)
    result = nil
  elseif k == "c" then
    expr, result = "", nil
  elseif k == "=" or k == "enter" then
    local t = nil
    local boom = t.value
    local ok, v = pcall(evaluate, expr)
    if ok then result = string.format("%.10g", v) else result = tostring(v):gsub("^.-:%d+: ", "") end
  end
end
===END===
